<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <PublishAot>true</PublishAot>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableStaticFfmpeg>true</EnableStaticFfmpeg>
    <FfmpegPackageVersion Condition="'$(FfmpegPackageVersion)' == ''">9.0.2.1</FfmpegPackageVersion>
    <LightStudioFfmpegStaticLibraryDir Condition="'$(UseLocalFfmpegArtifacts)' == 'true'">$(MSBuildThisFileDirectory)../../../artifacts/ffmpeg-$(RuntimeIdentifier)</LightStudioFfmpegStaticLibraryDir>
    <DefineConstants Condition="'$(EnableStaticFfmpeg)' == 'true'">$(DefineConstants);FFMPEG_STATIC</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="FFmpeg.AutoGen.Abstractions" Version="9.0.1.1" />
    <PackageReference Include="FFmpeg.AutoGen.Bindings.StaticallyLinked" Version="9.0.1.1" Condition="'$(EnableStaticFfmpeg)' == 'true'" />
    <PackageReference Include="FFmpeg.AutoGen.Bindings.DynamicallyLoaded" Version="9.0.1.1" Condition="'$(EnableStaticFfmpeg)' != 'true'" />
    <PackageReference Include="LightStudio.Ffmpeg" Version="$(FfmpegPackageVersion)" Condition="'$(UseLocalFfmpegArtifacts)' != 'true'" />
    <DirectPInvoke Include="__Internal" Condition="'$(EnableStaticFfmpeg)' == 'true'" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseLocalFfmpegArtifacts)' == 'true' and '$(EnableStaticFfmpeg)' != 'true'">
    <None Include="$(LightStudioFfmpegStaticLibraryDir)/*.dll" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Import Project="../../../package/build/LightStudio.Ffmpeg.props" Condition="'$(UseLocalFfmpegArtifacts)' == 'true'" />
  <Import Project="../../../package/build/LightStudio.Ffmpeg.targets" Condition="'$(UseLocalFfmpegArtifacts)' == 'true'" />
</Project>