<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OnnxPackageVersion Condition="'$(OnnxPackageVersion)' == ''">1.30.0-local.1</OnnxPackageVersion>
    <RestoreAdditionalProjectSources>$(MSBuildThisFileDirectory)../../../artifacts/packages</RestoreAdditionalProjectSources>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="LightStudio.Onnx" Version="$(OnnxPackageVersion)" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime.Managed" Version="1.30.0" Condition="'$(OnnxTestConflictingReference)' == 'true'" />
  </ItemGroup>
</Project>