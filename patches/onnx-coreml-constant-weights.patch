+// Replace an immediate tensor value with a weight file reference, matching initializer handling.
+template <typename T>
+void WriteToWeightsFile(MILSpec::Value& value, MILBlob::Util::Span<const T> data, MILBlob::Blob::StorageWriter& writer) {
+  auto* file_value = value.mutable_blobfilevalue();
+  file_value->set_filename("@model_path/weights/weight.bin");
+  file_value->set_offset(writer.WriteData(data));
+}
+
 MILSpec::Value OnnxTensorToCoreMLTensor(const ONNX_NAMESPACE::TensorProto& tensor_proto,
                                         MILBlob::Blob::StorageWriter& weights_file_writer) {
