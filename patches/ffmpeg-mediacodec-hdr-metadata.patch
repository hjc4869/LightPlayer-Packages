diff --git a/libavcodec/mediacodecdec_metadata.c b/libavcodec/mediacodecdec_metadata.c
new file mode 100644
index 0000000000..255f598eae
--- /dev/null
+++ b/libavcodec/mediacodecdec_metadata.c
@@ -0,0 +1,493 @@
