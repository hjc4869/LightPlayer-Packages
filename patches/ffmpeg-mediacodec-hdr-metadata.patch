+ * License along with FFmpeg; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
+ */
+
+#include "config_components.h"
+
+#include <stdint.h>
+#include <string.h>
+
+#include "libavutil/buffer.h"
+#include "libavutil/dovi_meta.h"
+#include "libavutil/mem.h"
+
+#include "decode.h"
+#include "dovi_rpu.h"
+#include "itut35.h"
+#include "mediacodecdec_metadata.h"
+#include "sei.h"
+
+#if CONFIG_AV1_MEDIACODEC_DECODER
+#include "av1.h"
+#include "av1_parse.h"
+#endif
+
+#if CONFIG_HEVC_MEDIACODEC_DECODER
+#include "hevc/hevc.h"
+#endif
+
+#define BITSTREAM_METADATA (CONFIG_HEVC_MEDIACODEC_DECODER || CONFIG_AV1_MEDIACODEC_DECODER)
+
+/* More than the pictures a codec keeps in flight; once full, the oldest entry
+ * belongs to a picture MediaCodec dropped. */
+#define MAX_PENDING 64
+
+typedef struct PendingMetadata {
+    int64_t pts;
+    AVPacket *props;
+    AVBufferRef *dovi;
+    AVBufferRef *dovi_rpu;
+    AVBufferRef *hdr_plus;
+} PendingMetadata;
+
+struct MediaCodecDecMetadata {
+#if BITSTREAM_METADATA
+    DOVIContext dovi;
+    /* Dolby Vision metadata applies to every HEVC picture until the next RPU. */
+    AVBufferRef *current_dovi;
+
+    uint8_t *rbsp;
+    unsigned int rbsp_size;
+#endif
+
+#if CONFIG_AV1_MEDIACODEC_DECODER
+    AV1Packet av1_pkt;
+#endif
+
+    PendingMetadata pending[MAX_PENDING];
+    int nb_pending;
+};
+
+static void pending_unref(PendingMetadata *p)
+{
+    av_packet_free(&p->props);
+    av_buffer_unref(&p->dovi);
+    av_buffer_unref(&p->dovi_rpu);
+    av_buffer_unref(&p->hdr_plus);
+}
+
+/* The timestamp the output frame carries after MediaCodec's microsecond round trip. */
+static int64_t output_pts(const AVCodecContext *avctx, int64_t pts)
+{
+    if (!avctx->pkt_timebase.num || !avctx->pkt_timebase.den)
+        return pts;
+    if (pts)
+        pts = av_rescale_q(pts, avctx->pkt_timebase, AV_TIME_BASE_Q);
+    return av_rescale_q(pts, AV_TIME_BASE_Q, avctx->pkt_timebase);
+}
+
+#if BITSTREAM_METADATA
+static int parse_t35(AVCodecContext *avctx, PendingMetadata *p, DOVIContext *dovi,
+                     const uint8_t *buf, int size)
+{
+    FFITUTT35 itut_t35 = { 0 };
+    FFITUTT35Aux aux = { .dovi = dovi };
+    FFITUTT35Meta meta = { 0 };
+    int ret;
+
+    ret = ff_itut_t35_parse_buffer(&itut_t35, buf, size, 0);
+    if (ret <= 0)
+        return 0;
+
+    ret = ff_itut_t35_parse_payload_to_struct(&itut_t35, &aux, &meta, avctx->err_recognition);
+    if (ret == AVERROR(ENOMEM)) {
+        ff_itut_t35_unref(&meta);
+        return ret;
+    }
+
+    if (meta.dovi) {
+        av_buffer_unref(&p->dovi);
+        p->dovi = meta.dovi;
+        meta.dovi = NULL;
+    }
+    if (meta.hdr_plus) {
+        av_buffer_unref(&p->hdr_plus);
+        p->hdr_plus = meta.hdr_plus;
+        meta.hdr_plus = NULL;
+    }
+    ff_itut_t35_unref(&meta);
+    return 0;
+}
+#endif
+
+#if CONFIG_HEVC_MEDIACODEC_DECODER
+static int find_start_code(const uint8_t *buf, int pos, int size)
+{
+    while (pos + 2 < size) {
+        if (buf[pos + 2] > 1)
+            pos += 3;
+        else if (buf[pos + 1])
+            pos += 2;
+        else if (buf[pos] || buf[pos + 2] != 1)
+            pos++;
+        else
+            return pos;
+    }
+    return size;
+}
+
+static int extract_rbsp(MediaCodecDecMetadata *m, const uint8_t *src, int size)
+{
+    int len = 0;
+
+    av_fast_padded_malloc(&m->rbsp, &m->rbsp_size, size);
+    if (!m->rbsp)
+        return AVERROR(ENOMEM);
+
+    for (int i = 0; i < size; i++) {
+        if (i + 2 < size && !src[i] && !src[i + 1] && src[i + 2] == 3) {
+            m->rbsp[len++] = 0;
+            m->rbsp[len++] = 0;
+            i += 2;
+            continue;
+        }
+        m->rbsp[len++] = src[i];
+    }
+    return len;
+}
+
+static int parse_hevc_sei(AVCodecContext *avctx, PendingMetadata *p,
+                          const uint8_t *buf, int size)
+{
+    int pos = 0;
+
+    while (size > 0 && !buf[size - 1])
+        size--;
+
+    /* The last byte holds the rbsp_trailing_bits. */
+    while (size - pos > 1) {
+        int type = 0, payload_size = 0, ret;
+
+        do {
+            if (pos >= size)
+                return 0;
+            type += buf[pos];
+        } while (buf[pos++] == 0xFF);
+
+        do {
+            if (pos >= size)
+                return 0;
+            payload_size += buf[pos];
+        } while (buf[pos++] == 0xFF);
+
+        if (payload_size > size - pos)
+            return 0;
+
+        if (type == SEI_TYPE_USER_DATA_REGISTERED_ITU_T_T35) {
+            ret = parse_t35(avctx, p, NULL, buf + pos, payload_size);
+            if (ret < 0)
+                return ret;
+        }
+        pos += payload_size;
+    }
+    return 0;
+}
+
+static int parse_hevc(AVCodecContext *avctx, MediaCodecDecMetadata *m,
+                      PendingMetadata *p, const AVPacket *pkt)
+{
+    const uint8_t *buf = pkt->data, *rpu = NULL;
+    int size = pkt->size, rpu_size = 0, nal_index = 0;
+    int pos = find_start_code(buf, 0, size);
+    int ret;
+
+    while (pos < size) {
+        int start = pos + 3, end, type, layer_id, temporal_id;
+
+        pos = end = find_start_code(buf, start, size);
+        while (end > start && !buf[end - 1])
+            end--;
+        if (end - start < 2)
+            continue;
+
+        type        = (buf[start] >> 1) & 0x3F;
+        layer_id    = ((buf[start] & 1) << 5) | (buf[start + 1] >> 3);
+        temporal_id = (buf[start + 1] & 7) - 1;
+
+        /* Same RPU selection as the native HEVC decoder: the last one in the
+         * access unit, never its first NAL unit. */
+        if (type == HEVC_NAL_UNSPEC62 && nal_index > 0 && end - start > 2 &&
+            !layer_id && !temporal_id) {
+            rpu      = buf + start;
+            rpu_size = end - start;
+        } else if (type == HEVC_NAL_SEI_PREFIX && !layer_id) {
+            ret = extract_rbsp(m, buf + start, end - start);
+            if (ret < 0)
+                return ret;
+            ret = parse_hevc_sei(avctx, p, m->rbsp + 2, ret - 2);
+            if (ret < 0)
+                return ret;
+        }
+        nal_index++;
+    }
+
+    if (rpu) {
+        AVDOVIMetadata *dovi;
+        int rbsp_size = extract_rbsp(m, rpu, rpu_size);
+        if (rbsp_size < 0)
+            return rbsp_size;
+
+        ret = ff_dovi_rpu_parse(&m->dovi, m->rbsp + 2, rbsp_size - 2, avctx->err_recognition);
+        if (ret < 0) {
+            av_log(avctx, AV_LOG_WARNING, "Error parsing DOVI NAL unit.\n");
+        } else {
+            p->dovi_rpu = av_buffer_alloc(rpu_size - 2);
+            if (!p->dovi_rpu)
+                return AVERROR(ENOMEM);
+            memcpy(p->dovi_rpu->data, rpu + 2, rpu_size - 2);
+        }
+
+        av_buffer_unref(&m->current_dovi);
+        ret = ff_dovi_get_metadata(&m->dovi, &dovi);
+        if (ret < 0)
+            return ret;
+        if (ret > 0) {
+            m->current_dovi = av_buffer_create((uint8_t *)dovi, ret, NULL, NULL, 0);
+            if (!m->current_dovi) {
+                av_free(dovi);
+                return AVERROR(ENOMEM);
+            }
+        }
+    }
+
+    if (m->current_dovi) {
+        p->dovi = av_buffer_ref(m->current_dovi);
+        if (!p->dovi)
+            return AVERROR(ENOMEM);
+    }
+    return 0;
+}
+#endif
+
+#if CONFIG_AV1_MEDIACODEC_DECODER
+static int read_leb128(const uint8_t *buf, int size, int *pos, uint64_t *value)
+{
+    *value = 0;
+    for (int i = 0; i < 8; i++) {
+        if (*pos >= size)
+            return AVERROR_INVALIDDATA;
+        *value |= (uint64_t)(buf[*pos] & 0x7F) << (i * 7);
+        if (!(buf[(*pos)++] & 0x80))
+            return 0;
+    }
+    return AVERROR_INVALIDDATA;
+}
+
+static int parse_av1(AVCodecContext *avctx, MediaCodecDecMetadata *m,
+                     PendingMetadata *p, const AVPacket *pkt)
+{
+    int ret = ff_av1_packet_split(&m->av1_pkt, pkt->data, pkt->size, avctx);
+    if (ret < 0)
+        return 0;
+
+    for (int i = 0; i < m->av1_pkt.nb_obus; i++) {
+        const AV1OBU *obu = &m->av1_pkt.obus[i];
+        int size = (obu->size_bits + 7) / 8, pos = 0;
+        uint64_t metadata_type;
+
+        if (obu->type != AV1_OBU_METADATA ||
+            read_leb128(obu->data, size, &pos, &metadata_type) < 0 ||
+            metadata_type != AV1_METADATA_TYPE_ITUT_T35)
+            continue;
+
+        ret = parse_t35(avctx, p, &m->dovi, obu->data + pos, size - pos);
+        if (ret < 0)
+            return ret;
+    }
+    return 0;
+}
+#endif
+
+int ff_mediacodec_dec_metadata_init(AVCodecContext *avctx, MediaCodecDecMetadata **out)
+{
+    MediaCodecDecMetadata *m;
+
+    *out = NULL;
+    if (avctx->codec_type != AVMEDIA_TYPE_VIDEO)
+        return 0;
+
+    m = av_mallocz(sizeof(*m));
+    if (!m)
+        return AVERROR(ENOMEM);
+
+#if BITSTREAM_METADATA
+    m->dovi.logctx = avctx;
+    if (avctx->codec_id == AV_CODEC_ID_AV1)
+        m->dovi.cfg.dv_profile = 10;
+    {
+        const AVPacketSideData *sd = ff_get_coded_side_data(avctx, AV_PKT_DATA_DOVI_CONF);
+        if (sd && sd->size >= sizeof(m->dovi.cfg))
+            m->dovi.cfg = *(const AVDOVIDecoderConfigurationRecord *)sd->data;
+    }
+#endif
+
+    *out = m;
+    return 0;
+}
+
+int ff_mediacodec_dec_metadata_parse(AVCodecContext *avctx, MediaCodecDecMetadata *m,
+                                     const AVPacket *pkt)
+{
+    PendingMetadata p = { 0 };
+    int ret = 0;
+
+    if (!m || !pkt->size)
+        return 0;
+
+#if BITSTREAM_METADATA
+    {
+        size_t sd_size;
+        const uint8_t *sd = av_packet_get_side_data(pkt, AV_PKT_DATA_DOVI_CONF, &sd_size);
+        if (sd && sd_size >= sizeof(m->dovi.cfg))
+            m->dovi.cfg = *(const AVDOVIDecoderConfigurationRecord *)sd;
+    }
+#endif
+
+#if CONFIG_HEVC_MEDIACODEC_DECODER
+    if (avctx->codec_id == AV_CODEC_ID_HEVC)
+        ret = parse_hevc(avctx, m, &p, pkt);
+#endif
+#if CONFIG_AV1_MEDIACODEC_DECODER
+    if (avctx->codec_id == AV_CODEC_ID_AV1)
+        ret = parse_av1(avctx, m, &p, pkt);
+#endif
+    if (ret < 0)
+        goto fail;
+
+    /* MediaCodec turns a missing timestamp into 0 for every packet, so the
+     * pictures could not be told apart. */
+    if (pkt->pts == AV_NOPTS_VALUE) {
+        pending_unref(&p);
+        return 0;
+    }
+
+    p.props = av_packet_alloc();
+    if (!p.props) {
+        ret = AVERROR(ENOMEM);
+        goto fail;
+    }
+    ret = av_packet_copy_props(p.props, pkt);
+    if (ret < 0)
+        goto fail;
+
+    p.pts = output_pts(avctx, pkt->pts);
+    if (m->nb_pending == MAX_PENDING) {
+        pending_unref(&m->pending[0]);
+        memmove(&m->pending[0], &m->pending[1], (MAX_PENDING - 1) * sizeof(*m->pending));
+        m->nb_pending--;
+    }
+    m->pending[m->nb_pending++] = p;
+    return 0;
+
+fail:
+    pending_unref(&p);
+    return ret;
+}
+
+static int attach_dovi(AVFrame *frame, enum AVFrameSideDataType type, AVBufferRef **buf)
+{
+    if (!*buf)
+        return 0;
+    if (!av_frame_new_side_data_from_buf(frame, type, *buf))
+        return AVERROR(ENOMEM);
+    *buf = NULL;
+    return 0;
+}
+
+int ff_mediacodec_dec_metadata_attach(AVCodecContext *avctx, MediaCodecDecMetadata *m,
+                                      AVFrame *frame)
+{
+    /* Per-frame types ff_decode_frame_props_from_pkt() maps for video. */
+    static const enum AVFrameSideDataType per_frame[] = {
+        AV_FRAME_DATA_A53_CC,
+        AV_FRAME_DATA_AFD,
+        AV_FRAME_DATA_DYNAMIC_HDR_PLUS,
+        AV_FRAME_DATA_DYNAMIC_HDR_SMPTE_2094_APP5,
+        AV_FRAME_DATA_S12M_TIMECODE,
+        AV_FRAME_DATA_LCEVC,
+    };
+    PendingMetadata p;
+    int i, ret = 0;
+
+    if (!m || frame->pts == AV_NOPTS_VALUE)
+        return 0;
+
+    /* Pictures leave the codec in presentation order, entries arrive in decode order. */
+    for (i = 0; i < m->nb_pending && m->pending[i].pts != frame->pts; i++)
+        ;
+    if (i == m->nb_pending)
+        return 0;
+
+    p = m->pending[i];
+    memmove(&m->pending[i], &m->pending[i + 1], (m->nb_pending - i - 1) * sizeof(*m->pending));
+    m->nb_pending--;
+
+    /* A buffer from ff_get_buffer() already holds the side data of the latest
+     * packet fed to the codec, rather than of this picture's own packet. */
+    for (int j = 0; j < FF_ARRAY_ELEMS(per_frame); j++)
+        av_frame_remove_side_data(frame, per_frame[j]);
+
+    /* Packet properties first, so bitstream metadata takes precedence the way
+     * it does in the native decoders. */
+    if ((ret = ff_decode_frame_props_from_pkt(avctx, frame, p.props)) < 0 ||
+        (ret = attach_dovi(frame, AV_FRAME_DATA_DOVI_RPU_BUFFER, &p.dovi_rpu)) < 0 ||
+        (ret = attach_dovi(frame, AV_FRAME_DATA_DOVI_METADATA, &p.dovi)) < 0)
+        goto end;
+
+    if (p.hdr_plus)
+        ret = ff_frame_new_side_data_from_buf(avctx, frame, AV_FRAME_DATA_DYNAMIC_HDR_PLUS,
+                                              &p.hdr_plus);
+
+end:
+    pending_unref(&p);
+    return ret;
+}
+
+void ff_mediacodec_dec_metadata_flush(MediaCodecDecMetadata *m)
+{
+    if (!m)
+        return;
+
+    for (int i = 0; i < m->nb_pending; i++)
+        pending_unref(&m->pending[i]);
+    m->nb_pending = 0;
+
+#if BITSTREAM_METADATA
+    av_buffer_unref(&m->current_dovi);
+    ff_dovi_ctx_flush(&m->dovi);
+#endif
+}
+
+void ff_mediacodec_dec_metadata_free(MediaCodecDecMetadata **pm)
+{
+    MediaCodecDecMetadata *m = *pm;
+
+    if (!m)
+        return;
+
+    ff_mediacodec_dec_metadata_flush(m);
+#if BITSTREAM_METADATA
+    ff_dovi_ctx_unref(&m->dovi);
+    av_freep(&m->rbsp);
+#endif
+#if CONFIG_AV1_MEDIACODEC_DECODER
+    ff_av1_packet_uninit(&m->av1_pkt);
+#endif
+    av_freep(pm);
+}
