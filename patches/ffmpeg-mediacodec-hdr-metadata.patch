+#ifndef AVCODEC_MEDIACODECDEC_METADATA_H
+#define AVCODEC_MEDIACODECDEC_METADATA_H
+
+#include "libavutil/frame.h"
+
+#include "avcodec.h"
+#include "packet.h"
+
+/**
+ * MediaCodec returns neither the packets' properties nor the bitstream's
+ * dynamic HDR metadata. Both are taken from the input packets in decode order
+ * and attached to the output frames matched by their presentation timestamps.
+ */
+typedef struct MediaCodecDecMetadata MediaCodecDecMetadata;
+
+/**
+ * @return 0 on success, or a negative AVERROR code. *out is left NULL for
+ *         audio codecs.
+ */
+int ff_mediacodec_dec_metadata_init(AVCodecContext *avctx, MediaCodecDecMetadata **out);
+
+/**
+ * Parse one packet as it is handed to MediaCodec. Malformed metadata is
+ * skipped; only allocation failures are reported.
+ */
+int ff_mediacodec_dec_metadata_parse(AVCodecContext *avctx, MediaCodecDecMetadata *m,
+                                     const AVPacket *pkt);
+
+/**
+ * Attach the properties and metadata of the packet whose timestamp the frame
+ * carries.
+ */
+int ff_mediacodec_dec_metadata_attach(AVCodecContext *avctx, MediaCodecDecMetadata *m,
+                                      AVFrame *frame);
+
+void ff_mediacodec_dec_metadata_flush(MediaCodecDecMetadata *m);
+
+void ff_mediacodec_dec_metadata_free(MediaCodecDecMetadata **m);
+
