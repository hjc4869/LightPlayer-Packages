<Project>
  <PropertyGroup>
    <!-- Blazor/wasm projects set browser-wasm as the RID; class libraries only carry the platform identifier. -->
    <_LightStudioFfmpegTargetsWasm>false</_LightStudioFfmpegTargetsWasm>
    <_LightStudioFfmpegTargetsWasm Condition="'$(RuntimeIdentifier)' == 'browser-wasm' or '$(TargetPlatformIdentifier)' == 'browser'">true</_LightStudioFfmpegTargetsWasm>

    <_LightStudioFfmpegWasmEmsdk>em3</_LightStudioFfmpegWasmEmsdk>
    <_LightStudioFfmpegWasmEmsdk Condition="'$(TargetFrameworkVersion)' != '' and $([MSBuild]::VersionGreaterThanOrEquals('$(TargetFrameworkVersion)', '11.0'))">em6</_LightStudioFfmpegWasmEmsdk>
    <_LightStudioFfmpegWasmFlavor>wasm-$(_LightStudioFfmpegWasmEmsdk)</_LightStudioFfmpegWasmFlavor>
    <_LightStudioFfmpegWasmFlavor Condition="'$(WasmEnableThreads)' == 'true'">wasm-mt-$(_LightStudioFfmpegWasmEmsdk)</_LightStudioFfmpegWasmFlavor>

    <!-- Only runtimes that ship static archives and support native AOT can be linked statically. -->
    <_LightStudioFfmpegStaticRid Condition="'$(RuntimeIdentifier)' == 'osx-arm64'">osx-arm64</_LightStudioFfmpegStaticRid>
    <_LightStudioFfmpegStaticRid Condition="'$(RuntimeIdentifier)' == 'win-x64' or '$(RuntimeIdentifier)' == 'win-arm64'">$(RuntimeIdentifier)</_LightStudioFfmpegStaticRid>
    <_LightStudioFfmpegStaticRid Condition="'$(RuntimeIdentifier)' == 'android-arm64' or '$(RuntimeIdentifier)' == 'android-x64'">$(RuntimeIdentifier)</_LightStudioFfmpegStaticRid>
    <LightStudioFfmpegStaticLibraryDir Condition="'$(LightStudioFfmpegStaticLibraryDir)' == ''">$(LightStudioFfmpegPackageRoot)static/$(_LightStudioFfmpegStaticRid)</LightStudioFfmpegStaticLibraryDir>

    <_LightStudioFfmpegUseStatic>false</_LightStudioFfmpegUseStatic>
    <_LightStudioFfmpegUseStatic Condition="'$(EnableStaticFfmpeg)' == 'true' and '$(PublishAot)' == 'true' and '$(_LightStudioFfmpegStaticRid)' != ''">true</_LightStudioFfmpegUseStatic>
  </PropertyGroup>

  <ItemGroup Condition="'$(_LightStudioFfmpegTargetsWasm)' == 'true'">
    <NativeFileReference Include="$(LightStudioFfmpegPackageRoot)static/$(_LightStudioFfmpegWasmFlavor)/*.a" />
  </ItemGroup>

  <ItemGroup Condition="'$(_LightStudioFfmpegUseStatic)' == 'true' and '$(_LightStudioFfmpegStaticRid)' == 'osx-arm64'">
    <NativeLibrary Include="$(LightStudioFfmpegStaticLibraryDir)/*.a" />
  </ItemGroup>

  <ItemGroup Condition="'$(_LightStudioFfmpegUseStatic)' == 'true' and ('$(_LightStudioFfmpegStaticRid)' == 'android-arm64' or '$(_LightStudioFfmpegStaticRid)' == 'android-x64')">
    <_LightStudioFfmpegAndroidLibrary Include="avcodec;avdevice;avfilter;avformat;avutil;swresample;swscale;dav1d;jxl;jxl_cms;jxl_threads;hwy;brotlicommon;brotlidec;brotlienc;xml2" />
    <_LightStudioFfmpegAndroidArchive Include="@(_LightStudioFfmpegAndroidLibrary->'$(LightStudioFfmpegStaticLibraryDir)/lib%(Identity).a')" />
    <NativeLibrary Include="@(_LightStudioFfmpegAndroidArchive)" />
    <NativeSystemLibrary Include="c++_static;c++abi;z;android;mediandk;log;dl;m" />
    <LinkerArg Include="@(_LightStudioFfmpegAndroidArchive->'-Wl,--exclude-libs,%(Filename)%(Extension)')" />
    <LinkerArg Include="-Wl,-z,max-page-size=16384" />
  </ItemGroup>

  <Target Name="ValidateLightStudioFfmpegAndroidStaticLibraries" BeforeTargets="PrepareForBuild;IlcCompile"
          Condition="'@(_LightStudioFfmpegAndroidArchive)' != ''">
    <Error Condition="!Exists('%(_LightStudioFfmpegAndroidArchive.Identity)')"
           Text="Missing FFmpeg static library '%(_LightStudioFfmpegAndroidArchive.Identity)'. Restore a complete LightStudio.Ffmpeg package or build the matching Android artifacts." />
  </Target>

  <ItemGroup Condition="'$(_LightStudioFfmpegUseStatic)' == 'true' and ('$(_LightStudioFfmpegStaticRid)' == 'win-x64' or '$(_LightStudioFfmpegStaticRid)' == 'win-arm64')">
    <_LightStudioFfmpegWindowsLibrary Include="avcodec;avdevice;avfilter;avformat;avutil;swresample;swscale;dav1d;jxl;jxl_cms;jxl_threads;hwy;brotlicommon;brotlidec;brotlienc;xml2;opus;zlib" />
    <_LightStudioFfmpegWindowsArchive Include="@(_LightStudioFfmpegWindowsLibrary->'$(LightStudioFfmpegStaticLibraryDir)/%(Identity).lib')" />
    <NativeLibrary Include="@(_LightStudioFfmpegWindowsArchive)" />
    <NativeLibrary Include="mfuuid.lib;ole32.lib;strmiids.lib;user32.lib;bcrypt.lib" />
  </ItemGroup>

  <Target Name="ValidateLightStudioFfmpegWindowsStaticLibraries" BeforeTargets="PrepareForBuild;IlcCompile"
          Condition="'@(_LightStudioFfmpegWindowsArchive)' != ''">
    <Error Condition="!Exists('%(_LightStudioFfmpegWindowsArchive.Identity)')"
           Text="Missing FFmpeg static library '%(_LightStudioFfmpegWindowsArchive.Identity)'. Restore a complete LightStudio.Ffmpeg package or build the matching Windows artifacts." />
  </Target>

  <ItemGroup Condition="'$(_LightStudioFfmpegUseStatic)' == 'true' and '$(_LightStudioFfmpegStaticRid)' == 'osx-arm64'">
    <!-- libjxl and its dependencies are C++, and the PNG/TIFF decoders need zlib. -->
    <LinkerArg Include="-lc++" />
    <LinkerArg Include="-lz" />
    <LinkerArg Include="-framework CoreMedia" />
    <LinkerArg Include="-framework CoreVideo" />
    <LinkerArg Include="-framework VideoToolbox" />
  </ItemGroup>

  <!-- Statically linked publishes must not also carry the shared libraries from runtimes/. -->
  <Target Name="RemoveLightStudioFfmpegRuntimeAssets"
          AfterTargets="ComputeResolvedFilesToPublishList"
          Condition="'$(_LightStudioFfmpegUseStatic)' == 'true'">
    <ItemGroup>
      <_LightStudioFfmpegPublishAssetToRemove Include="@(ResolvedFileToPublish)" Condition="'%(ResolvedFileToPublish.NuGetPackageId)' == 'LightStudio.Ffmpeg'" />
      <ResolvedFileToPublish Remove="@(_LightStudioFfmpegPublishAssetToRemove)" />
    </ItemGroup>
  </Target>
</Project>
