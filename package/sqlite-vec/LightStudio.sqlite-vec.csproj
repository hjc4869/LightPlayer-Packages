<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDefaultItems>false</EnableDefaultItems>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <PackageId>LightStudio.sqlite-vec</PackageId>
    <Version>0.1.9</Version>
    <Authors>LightStudio</Authors>
    <Description>sqlite-vec loadable native extensions for Linux, Windows, macOS, and Android on x64 and ARM64, plus single-threaded and multithreaded browser-wasm static libraries with bundled SQLite. Native platforms require your own SQLite engine; bring your own managed bindings on all platforms.</Description>
    <PackageTags>sqlite;sqlite-vec;vec0;vector;search;android;linux;macos;windows;wasm</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/hjc4869/LightPlayer-Packages</RepositoryUrl>
    <IsPackable>true</IsPackable>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <SqliteVecArtifactsPath Condition="'$(SqliteVecArtifactsPath)' == ''">$(MSBuildThisFileDirectory)../../artifacts</SqliteVecArtifactsPath>
    <_SqliteVecAllRids>linux-x64;linux-arm64;win-x64;win-arm64;osx-x64;osx-arm64;android-x64;android-arm64;browser-wasm</_SqliteVecAllRids>
    <SqliteVecRuntimeIdentifiers Condition="'$(SqliteVecRuntimeIdentifiers)' == ''">$(_SqliteVecAllRids)</SqliteVecRuntimeIdentifiers>
    <_SqliteVecSelectedRids>;$(SqliteVecRuntimeIdentifiers);</_SqliteVecSelectedRids>
  </PropertyGroup>

  <ItemGroup>
    <None Include="build/LightStudio.sqlite-vec.targets" Pack="true" PackagePath="build/;buildTransitive/" />
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup Condition="$(_SqliteVecSelectedRids.Contains(';linux-x64;'))">
    <None Include="$(SqliteVecArtifactsPath)/sqlite-vec-linux-x64/vec0.so" Pack="true" PackagePath="runtimes/linux-x64/native/" />
    <None Include="$(SqliteVecArtifactsPath)/sqlite-vec-linux-x64/build-info.txt" Pack="true" PackagePath="build-info/linux-x64.txt" />
    <None Include="$(SqliteVecArtifactsPath)/sqlite-vec-linux-x64/licenses/**/*" Pack="true" PackagePath="licenses/linux-x64/" />
  </ItemGroup>
  <ItemGroup Condition="$(_SqliteVecSelectedRids.Contains(';linux-arm64;'))">
    <None Include="$(SqliteVecArtifactsPath)/sqlite-vec-linux-arm64/vec0.so" Pack="true" PackagePath="runtimes/linux-arm64/native/" />
    <None Include="$(SqliteVecArtifactsPath)/sqlite-vec-linux-arm64/build-info.txt" Pack="true" PackagePath="build-info/linux-arm64.txt" />
    <None Include="$(SqliteVecArtifactsPath)/sqlite-vec-linux-arm64/licenses/**/*" Pack="true" PackagePath="licenses/linux-arm64/" />
  </ItemGroup>
  <ItemGroup Condition="$(_SqliteVecSelectedRids.Contains(';win-x64;'))">
    <None Include="$(SqliteVecArtifactsPath)/sqlite-vec-win-x64/vec0.dll" Pack="true" PackagePath="runtimes/win-x64/native/" />
    <None Include="$(SqliteVecArtifactsPath)/sqlite-vec-win-x64/build-info.txt" Pack="true" PackagePath="build-info/win-x64.txt" />
    <None Include="$(SqliteVecArtifactsPath)/sqlite-vec-win-x64/licenses/**/*" Pack="true" PackagePath="licenses/win-x64/" />
  </ItemGroup>
  <ItemGroup Condition="$(_SqliteVecSelectedRids.Contains(';win-arm64;'))">
    <None Include="$(SqliteVecArtifactsPath)/sqlite-vec-win-arm64/vec0.dll" Pack="true" PackagePath="runtimes/win-arm64/native/" />
    <None Include="$(SqliteVecArtifactsPath)/sqlite-vec-win-arm64/build-info.txt" Pack="true" PackagePath="build-info/win-arm64.txt" />
    <None Include="$(SqliteVecArtifactsPath)/sqlite-vec-win-arm64/licenses/**/*" Pack="true" PackagePath="licenses/win-arm64/" />
  </ItemGroup>
  <ItemGroup Condition="$(_SqliteVecSelectedRids.Contains(';osx-x64;'))">
    <None Include="$(SqliteVecArtifactsPath)/sqlite-vec-osx-x64/vec0.dylib" Pack="true" PackagePath="runtimes/osx-x64/native/" />
    <None Include="$(SqliteVecArtifactsPath)/sqlite-vec-osx-x64/build-info.txt" Pack="true" PackagePath="build-info/osx-x64.txt" />
    <None Include="$(SqliteVecArtifactsPath)/sqlite-vec-osx-x64/licenses/**/*" Pack="true" PackagePath="licenses/osx-x64/" />
  </ItemGroup>
  <ItemGroup Condition="$(_SqliteVecSelectedRids.Contains(';osx-arm64;'))">
    <None Include="$(SqliteVecArtifactsPath)/sqlite-vec-osx-arm64/vec0.dylib" Pack="true" PackagePath="runtimes/osx-arm64/native/" />
    <None Include="$(SqliteVecArtifactsPath)/sqlite-vec-osx-arm64/build-info.txt" Pack="true" PackagePath="build-info/osx-arm64.txt" />
    <None Include="$(SqliteVecArtifactsPath)/sqlite-vec-osx-arm64/licenses/**/*" Pack="true" PackagePath="licenses/osx-arm64/" />
  </ItemGroup>
  <ItemGroup Condition="$(_SqliteVecSelectedRids.Contains(';android-x64;'))">
    <None Include="$(SqliteVecArtifactsPath)/sqlite-vec-android-x64/libvec0.so" Pack="true" PackagePath="runtimes/android-x64/native/" />
    <None Include="$(SqliteVecArtifactsPath)/sqlite-vec-android-x64/build-info.txt" Pack="true" PackagePath="build-info/android-x64.txt" />
    <None Include="$(SqliteVecArtifactsPath)/sqlite-vec-android-x64/licenses/**/*" Pack="true" PackagePath="licenses/android-x64/" />
  </ItemGroup>
  <ItemGroup Condition="$(_SqliteVecSelectedRids.Contains(';android-arm64;'))">
    <None Include="$(SqliteVecArtifactsPath)/sqlite-vec-android-arm64/libvec0.so" Pack="true" PackagePath="runtimes/android-arm64/native/" />
    <None Include="$(SqliteVecArtifactsPath)/sqlite-vec-android-arm64/build-info.txt" Pack="true" PackagePath="build-info/android-arm64.txt" />
    <None Include="$(SqliteVecArtifactsPath)/sqlite-vec-android-arm64/licenses/**/*" Pack="true" PackagePath="licenses/android-arm64/" />
  </ItemGroup>

  <ItemGroup Condition="$(_SqliteVecSelectedRids.Contains(';browser-wasm;'))">
    <None Include="$(SqliteVecArtifactsPath)/sqlite-vec-browser-wasm-em3/libvec0.a" Pack="true" PackagePath="static/wasm-em3/" />
    <None Include="$(SqliteVecArtifactsPath)/sqlite-vec-browser-wasm-mt-em3/libvec0.a" Pack="true" PackagePath="static/wasm-mt-em3/" />
    <None Include="$(SqliteVecArtifactsPath)/sqlite-vec-browser-wasm-em6/libvec0.a" Pack="true" PackagePath="static/wasm-em6/" />
    <None Include="$(SqliteVecArtifactsPath)/sqlite-vec-browser-wasm-mt-em6/libvec0.a" Pack="true" PackagePath="static/wasm-mt-em6/" />
    <None Include="$(SqliteVecArtifactsPath)/sqlite-vec-browser-wasm-em3/libsqlite3.a" Pack="true" PackagePath="static/wasm-em3/" />
    <None Include="$(SqliteVecArtifactsPath)/sqlite-vec-browser-wasm-mt-em3/libsqlite3.a" Pack="true" PackagePath="static/wasm-mt-em3/" />
    <None Include="$(SqliteVecArtifactsPath)/sqlite-vec-browser-wasm-em6/libsqlite3.a" Pack="true" PackagePath="static/wasm-em6/" />
    <None Include="$(SqliteVecArtifactsPath)/sqlite-vec-browser-wasm-mt-em6/libsqlite3.a" Pack="true" PackagePath="static/wasm-mt-em6/" />
    <None Include="$(SqliteVecArtifactsPath)/sqlite-vec-browser-wasm-em3/build-info.txt" Pack="true" PackagePath="build-info/browser-wasm-em3.txt" />
    <None Include="$(SqliteVecArtifactsPath)/sqlite-vec-browser-wasm-mt-em3/build-info.txt" Pack="true" PackagePath="build-info/browser-wasm-mt-em3.txt" />
    <None Include="$(SqliteVecArtifactsPath)/sqlite-vec-browser-wasm-em6/build-info.txt" Pack="true" PackagePath="build-info/browser-wasm-em6.txt" />
    <None Include="$(SqliteVecArtifactsPath)/sqlite-vec-browser-wasm-mt-em6/build-info.txt" Pack="true" PackagePath="build-info/browser-wasm-mt-em6.txt" />
    <None Include="$(SqliteVecArtifactsPath)/sqlite-vec-browser-wasm-em3/licenses/**/*" Pack="true" PackagePath="licenses/browser-wasm-em3/" />
    <None Include="$(SqliteVecArtifactsPath)/sqlite-vec-browser-wasm-mt-em3/licenses/**/*" Pack="true" PackagePath="licenses/browser-wasm-mt-em3/" />
    <None Include="$(SqliteVecArtifactsPath)/sqlite-vec-browser-wasm-em6/licenses/**/*" Pack="true" PackagePath="licenses/browser-wasm-em6/" />
    <None Include="$(SqliteVecArtifactsPath)/sqlite-vec-browser-wasm-mt-em6/licenses/**/*" Pack="true" PackagePath="licenses/browser-wasm-mt-em6/" />
  </ItemGroup>
</Project>