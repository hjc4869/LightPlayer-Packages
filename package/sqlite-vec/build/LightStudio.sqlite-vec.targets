<Project>
  <PropertyGroup>
    <_LightStudioSqliteVecSupportedRids>;linux-x64;linux-arm64;win-x64;win-arm64;osx-x64;osx-arm64;ios-arm64;iossimulator-arm64;android-x64;android-arm64;browser-wasm;</_LightStudioSqliteVecSupportedRids>
    <_LightStudioSqliteVecTargetsWasm>false</_LightStudioSqliteVecTargetsWasm>
    <_LightStudioSqliteVecTargetsWasm Condition="'$(RuntimeIdentifier)' == 'browser-wasm' or '$(TargetPlatformIdentifier)' == 'browser'">true</_LightStudioSqliteVecTargetsWasm>
    <_LightStudioSqliteVecWasmEmsdk>em3</_LightStudioSqliteVecWasmEmsdk>
    <_LightStudioSqliteVecWasmEmsdk Condition="'$(TargetFrameworkVersion)' != '' and $([MSBuild]::VersionGreaterThanOrEquals('$(TargetFrameworkVersion)', '11.0'))">em6</_LightStudioSqliteVecWasmEmsdk>
    <_LightStudioSqliteVecWasmFlavor>wasm-$(_LightStudioSqliteVecWasmEmsdk)</_LightStudioSqliteVecWasmFlavor>
    <_LightStudioSqliteVecWasmFlavor Condition="'$(WasmEnableThreads)' == 'true'">wasm-mt-$(_LightStudioSqliteVecWasmEmsdk)</_LightStudioSqliteVecWasmFlavor>
    <_LightStudioSqliteVecWasmArchive>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../static/$(_LightStudioSqliteVecWasmFlavor)/libvec0.a'))</_LightStudioSqliteVecWasmArchive>
    <_LightStudioSqliteWasmArchive>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../static/$(_LightStudioSqliteVecWasmFlavor)/libsqlite3.a'))</_LightStudioSqliteWasmArchive>
    <_LightStudioSqliteVecStaticRid />
    <_LightStudioSqliteVecStaticRid Condition="'$(RuntimeIdentifier)' == 'win-x64' or '$(RuntimeIdentifier)' == 'win-arm64' or '$(RuntimeIdentifier)' == 'osx-x64' or '$(RuntimeIdentifier)' == 'osx-arm64'">$(RuntimeIdentifier)</_LightStudioSqliteVecStaticRid>
    <_LightStudioSqliteVecUseStatic>false</_LightStudioSqliteVecUseStatic>
    <_LightStudioSqliteVecUseStatic Condition="'$(EnableStaticSqliteVec)' == 'true' and '$(PublishAot)' == 'true' and '$(_LightStudioSqliteVecStaticRid)' != ''">true</_LightStudioSqliteVecUseStatic>
  </PropertyGroup>
  <ItemGroup Condition="'$(_LightStudioSqliteVecTargetsWasm)' == 'true'">
    <NativeFileReference Include="$(_LightStudioSqliteVecWasmArchive)" Exclude="@(NativeFileReference)" />
    <NativeFileReference Include="$(_LightStudioSqliteWasmArchive)" Exclude="@(NativeFileReference)" />
  </ItemGroup>
  <ItemGroup Condition="'$(_LightStudioSqliteVecUseStatic)' == 'true' and ('$(_LightStudioSqliteVecStaticRid)' == 'win-x64' or '$(_LightStudioSqliteVecStaticRid)' == 'win-arm64')">
    <NativeLibrary Include="$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../static/$(_LightStudioSqliteVecStaticRid)/vec0.lib'))" Exclude="@(NativeLibrary)" />
  </ItemGroup>
  <ItemGroup Condition="'$(_LightStudioSqliteVecUseStatic)' == 'true' and ('$(_LightStudioSqliteVecStaticRid)' == 'osx-x64' or '$(_LightStudioSqliteVecStaticRid)' == 'osx-arm64')">
    <NativeLibrary Include="$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../static/$(_LightStudioSqliteVecStaticRid)/libvec0.a'))" Exclude="@(NativeLibrary)" />
  </ItemGroup>
  <Target Name="ValidateLightStudioSqliteVecPlatform" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(RuntimeIdentifier)' != '' and !$([System.String]::Copy('$(_LightStudioSqliteVecSupportedRids)').Contains(';$(RuntimeIdentifier);'))" Text="LightStudio.sqlite-vec does not support RuntimeIdentifier '$(RuntimeIdentifier)'. Supported RIDs: $(_LightStudioSqliteVecSupportedRids)" />
    <Error Condition="'$(TargetPlatformIdentifier)' == 'android' and '$(SupportedOSPlatformVersion)' != '' and $([MSBuild]::VersionLessThan('$(SupportedOSPlatformVersion)', '27.0'))" Text="LightStudio.sqlite-vec requires Android API 27 or later. Set SupportedOSPlatformVersion to at least 27.0." />
  </Target>
  <Target Name="RemoveLightStudioSqliteVecRuntimeAssets" AfterTargets="ComputeResolvedFilesToPublishList"
          Condition="'$(_LightStudioSqliteVecUseStatic)' == 'true'">
    <ItemGroup>
      <_LightStudioSqliteVecPublishAssetToRemove Include="@(ResolvedFileToPublish)" Condition="'%(ResolvedFileToPublish.NuGetPackageId)' == 'LightStudio.sqlite-vec'" />
      <ResolvedFileToPublish Remove="@(_LightStudioSqliteVecPublishAssetToRemove)" />
    </ItemGroup>
  </Target>
</Project>