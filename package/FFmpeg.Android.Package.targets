<Project>
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Version>8.1.2</Version>
    <Authors>LightStudio</Authors>
    <PackageLicenseExpression>LGPL-2.1-or-later AND BSD-2-Clause</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/hjc4869/LightPlayer-Packages</RepositoryUrl>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(FFmpegArtifactsPath)/android-arm64/*.so" Pack="true" PackagePath="runtimes/android-arm64/native/" />
    <None Include="$(FFmpegArtifactsPath)/android-x64/*.so" Pack="true" PackagePath="runtimes/android-x64/native/" />
    <None Include="$(PackageReadmeFile)" Pack="true" PackagePath="/" />
    <None Include="../ffmpeg/LICENSE.md" Pack="true" PackagePath="licenses/FFmpeg-LICENSE.md" />
    <None Include="../ffmpeg/COPYING.LGPLv2.1" Pack="true" PackagePath="licenses/" />
    <None Include="../dav1d/COPYING" Pack="true" PackagePath="licenses/dav1d/" />
  </ItemGroup>

  <Target Name="ValidateFFmpegLibraries" BeforeTargets="GenerateNuspec">
    <ItemGroup>
      <_FFmpegArm64Library Include="$(FFmpegArtifactsPath)/android-arm64/*.so" />
      <_FFmpegX64Library Include="$(FFmpegArtifactsPath)/android-x64/*.so" />
    </ItemGroup>
    <Error Condition="'@(_FFmpegArm64Library)' == ''" Text="No android-arm64 FFmpeg shared libraries were found in '$(FFmpegArtifactsPath)/android-arm64'. Build FFmpeg before packing." />
    <Error Condition="'@(_FFmpegX64Library)' == ''" Text="No android-x64 FFmpeg shared libraries were found in '$(FFmpegArtifactsPath)/android-x64'. Build FFmpeg before packing." />
  </Target>
</Project>
