<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDefaultItems>false</EnableDefaultItems>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <PackageId>LightStudio.AvaloniaStatic.Native</PackageId>
    <Version>12.1.4</Version>
    <PackageVersion Condition="'$(PackageVersion)' == ''">$(Version)</PackageVersion>
    <Authors>LightStudio</Authors>
    <Description>Static Avalonia.Native libraries from release/12.1.4 for Avalonia NativeAOT on macOS, x64 and ARM64. The package version selects the exact matching managed Avalonia dependencies.</Description>
    <PackageTags>Avalonia;Avalonia.Native;NativeAOT;static;macos</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/hjc4869/LightPlayer-Packages</RepositoryUrl>
    <IsPackable>true</IsPackable>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <AvaloniaStaticNativeArtifactsPath Condition="'$(AvaloniaStaticNativeArtifactsPath)' == ''">$(MSBuildThisFileDirectory)../../artifacts</AvaloniaStaticNativeArtifactsPath>
    <NuspecFile>$(MSBuildThisFileDirectory)LightStudio.AvaloniaStatic.Native.nuspec</NuspecFile>
    <NuspecBasePath>$(MSBuildThisFileDirectory)</NuspecBasePath>
    <NuspecProperties>id=$(PackageId);version=$(PackageVersion);authors=$(Authors);description=$(Description);tags=$([System.String]::Copy('$(PackageTags)').Replace(';', ' '));readme=$(PackageReadmeFile);license=$(PackageLicenseExpression);repositoryType=$(RepositoryType);repositoryUrl=$(RepositoryUrl);framework=$(TargetFramework);artifacts=$(AvaloniaStaticNativeArtifactsPath)</NuspecProperties>
  </PropertyGroup>

  <ItemGroup>
    <None Include="build/LightStudio.AvaloniaStatic.Native.targets" Pack="true" PackagePath="buildTransitive/" />
    <None Include="README.md;THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="/" />
    <_MacRid Include="osx-x64;osx-arm64" />
  </ItemGroup>

  <Target Name="CollectAvaloniaStaticNativeFiles" BeforeTargets="_GetPackageFiles">
    <ItemGroup>
      <_RequiredArchive Include="$(AvaloniaStaticNativeArtifactsPath)/avalonia-static-native-%(_MacRid.Identity)/libAvaloniaNative.a;$(AvaloniaStaticNativeArtifactsPath)/avalonia-static-native-%(_MacRid.Identity)/macos_font_preinit.o">
        <Rid>%(_MacRid.Identity)</Rid>
      </_RequiredArchive>
      <_RequiredMetadata Include="$(AvaloniaStaticNativeArtifactsPath)/avalonia-static-native-%(_MacRid.Identity)/build-info.json;$(AvaloniaStaticNativeArtifactsPath)/avalonia-static-native-%(_MacRid.Identity)/licenses/avalonia/licence.md" />
    </ItemGroup>
    <Error Condition="!Exists('%(_RequiredArchive.Identity)')" Text="Incomplete LightStudio.AvaloniaStatic.Native package: missing %(_RequiredArchive.Identity). Build both macOS RIDs before packing." />
    <Error Condition="!Exists('%(_RequiredMetadata.Identity)')" Text="Missing LightStudio.AvaloniaStatic.Native provenance or license: %(_RequiredMetadata.Identity)." />
    <ItemGroup>
      <None Include="@(_RequiredArchive)" Pack="true" PackagePath="static/%(_RequiredArchive.Rid)/" />
      <None Include="$(AvaloniaStaticNativeArtifactsPath)/avalonia-static-native-%(_MacRid.Identity)/build-info.json" Pack="true" PackagePath="build-info/%(_MacRid.Identity)/" />
      <None Include="$(AvaloniaStaticNativeArtifactsPath)/avalonia-static-native-%(_MacRid.Identity)/licenses/avalonia/**/*" Pack="true" PackagePath="licenses/%(_MacRid.Identity)/avalonia/%(RecursiveDir)" />
    </ItemGroup>
  </Target>
</Project>