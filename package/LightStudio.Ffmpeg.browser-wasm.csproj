<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>LightStudio.Ffmpeg.browser-wasm</PackageId>
    <Description>Single-threaded static FFmpeg libraries built with Emscripten for the browser-wasm runtime.</Description>
    <PackageTags>ffmpeg;webassembly;wasm;browser-wasm;emscripten;single-threaded</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <FFmpegArtifactsPath>$(MSBuildThisFileDirectory)../artifacts/ffmpeg-browser-wasm</FFmpegArtifactsPath>
  </PropertyGroup>

  <Import Project="FFmpeg.browser-wasm.Package.targets" />
</Project>