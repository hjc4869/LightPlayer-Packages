<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDefaultItems>false</EnableDefaultItems>

    <PackageId>LightStudio.Ffmpeg</PackageId>
    <Version>9.0.2.1</Version>
    <Authors>LightStudio</Authors>
    <Description>FFmpeg 9.0.2 LGPL native libraries for .NET, with HLS and DASH custom I/O support, dav1d (AV1), libjxl (JPEG XL), and common photo formats. Shared libraries for Android, osx-arm64, win-x64 and win-arm64, static archives for iOS ARM64 and browser-wasm, and NativeAOT static libraries for osx-arm64, win-x64 and win-arm64. macOS and Windows include transcoding filters and libopus encoding. Windows includes D3D11VA and Media Foundation support.</Description>
    <PackageTags>ffmpeg;native;nativeaot;lgpl;hls;dash;android;ios;osx-arm64;win-x64;win-arm64;d3d11va;mediafoundation;browser-wasm;webassembly;wasm;dav1d;libjxl;jpegxl;avif;heic</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>LGPL-2.1-or-later AND BSD-2-Clause AND BSD-3-Clause AND Apache-2.0 AND MIT AND Zlib</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/hjc4869/LightPlayer-Packages</RepositoryUrl>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <IsPackable>true</IsPackable>
    <NoWarn>$(NoWarn);NU5128</NoWarn>

    <FFmpegArtifactsPath>$(MSBuildThisFileDirectory)../artifacts</FFmpegArtifactsPath>
  </PropertyGroup>

  <ItemGroup Label="Dynamically linked runtime assets">
    <None Include="$(FFmpegArtifactsPath)/ffmpeg-win-x64/*.dll" Pack="true" PackagePath="runtimes/win-x64/native/" />
    <None Include="$(FFmpegArtifactsPath)/ffmpeg-win-arm64/*.dll" Pack="true" PackagePath="runtimes/win-arm64/native/" />
    <None Include="$(FFmpegArtifactsPath)/ffmpeg-android/android-arm64/*.so" Pack="true" PackagePath="runtimes/android-arm64/native/" />
    <None Include="$(FFmpegArtifactsPath)/ffmpeg-android/android-x64/*.so" Pack="true" PackagePath="runtimes/android-x64/native/" />
    <None Include="$(FFmpegArtifactsPath)/ffmpeg-osx-arm64/*.dylib" Pack="true" PackagePath="runtimes/osx-arm64/native/" />
  </ItemGroup>

  <ItemGroup Label="iOS statically linked runtime assets">
    <None Include="$(FFmpegArtifactsPath)/ffmpeg-ios-arm64/*.a" Pack="true" PackagePath="runtimes/ios-arm64/native/" />
    <None Include="$(FFmpegArtifactsPath)/ffmpeg-iossimulator-arm64/*.a" Pack="true" PackagePath="runtimes/iossimulator-arm64/native/" />
  </ItemGroup>

  <!-- Desktop and browser static archives use opt-in or platform-specific linking. -->
  <ItemGroup Label="Statically linked assets">
    <None Include="$(FFmpegArtifactsPath)/ffmpeg-win-x64/*.lib" Pack="true" PackagePath="static/win-x64/" />
    <None Include="$(FFmpegArtifactsPath)/ffmpeg-win-arm64/*.lib" Pack="true" PackagePath="static/win-arm64/" />
    <None Include="$(FFmpegArtifactsPath)/ffmpeg-osx-arm64/*.a" Pack="true" PackagePath="static/osx-arm64/" />
    <None Include="$(FFmpegArtifactsPath)/ffmpeg-browser-wasm-em3/*.a" Pack="true" PackagePath="static/wasm-em3/" />
    <None Include="$(FFmpegArtifactsPath)/ffmpeg-MT-browser-wasm-em3/*.a" Pack="true" PackagePath="static/wasm-mt-em3/" />
    <None Include="$(FFmpegArtifactsPath)/ffmpeg-browser-wasm-em6/*.a" Pack="true" PackagePath="static/wasm-em6/" />
    <None Include="$(FFmpegArtifactsPath)/ffmpeg-MT-browser-wasm-em6/*.a" Pack="true" PackagePath="static/wasm-mt-em6/" />
  </ItemGroup>

  <ItemGroup Label="Consumer MSBuild logic">
    <None Include="build/LightStudio.Ffmpeg.props" Pack="true" PackagePath="build/;buildTransitive/" />
    <None Include="build/LightStudio.Ffmpeg.targets" Pack="true" PackagePath="build/;buildTransitive/" />
  </ItemGroup>

  <ItemGroup Label="Documentation and licenses">
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="../ffmpeg/LICENSE.md" Pack="true" PackagePath="licenses/FFmpeg-LICENSE.md" />
    <None Include="../ffmpeg/COPYING.LGPLv2.1" Pack="true" PackagePath="licenses/" />
    <None Include="../dav1d/COPYING" Pack="true" PackagePath="licenses/dav1d/" />
    <None Include="../libjxl/LICENSE" Pack="true" PackagePath="licenses/libjxl/" />
    <None Include="../libxml2/Copyright" Pack="true" PackagePath="licenses/libxml2/" />
    <None Include="../opus/COPYING;../opus/LICENSE_PLEASE_READ.txt" Pack="true" PackagePath="licenses/opus/" />
    <None Include="../libjxl/third_party/brotli/LICENSE" Pack="true" PackagePath="licenses/brotli/" />
    <None Include="../libjxl/third_party/highway/LICENSE" Pack="true" PackagePath="licenses/highway/" />
    <None Include="../libjxl/third_party/skcms/LICENSE" Pack="true" PackagePath="licenses/skcms/" />
    <None Include="../zlib/LICENSE" Pack="true" PackagePath="licenses/zlib/" />
  </ItemGroup>
</Project>
