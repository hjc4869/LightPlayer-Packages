<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>LightStudio.Ffmpeg.Android</PackageId>
    <Description>Shared FFmpeg libraries built with the Android NDK for the .NET android-arm64 and android-x64 runtimes.</Description>
    <PackageTags>ffmpeg;android;arm64;x64;native;shared</PackageTags>
    <PackageReadmeFile>README.Android.md</PackageReadmeFile>
    <FFmpegArtifactsPath>$(MSBuildThisFileDirectory)../artifacts/ffmpeg-android</FFmpegArtifactsPath>
  </PropertyGroup>

  <Import Project="FFmpeg.Android.Package.targets" />
</Project>
