<Project>
  <PropertyGroup>
    <_LightStudioPhotosTargetsWasm>false</_LightStudioPhotosTargetsWasm>
    <_LightStudioPhotosTargetsWasm Condition="'$(RuntimeIdentifier)' == 'browser-wasm' or '$(TargetPlatformIdentifier)' == 'browser'">true</_LightStudioPhotosTargetsWasm>
    <_LightStudioPhotosWasmEmsdk>em3</_LightStudioPhotosWasmEmsdk>
    <_LightStudioPhotosWasmEmsdk Condition="'$(TargetFrameworkVersion)' != '' and $([MSBuild]::VersionGreaterThanOrEquals('$(TargetFrameworkVersion)', '11.0'))">em6</_LightStudioPhotosWasmEmsdk>
    <_LightStudioPhotosWasmFlavor>wasm-$(_LightStudioPhotosWasmEmsdk)</_LightStudioPhotosWasmFlavor>
    <_LightStudioPhotosWasmFlavor Condition="'$(WasmEnableThreads)' == 'true'">wasm-mt-$(_LightStudioPhotosWasmEmsdk)</_LightStudioPhotosWasmFlavor>
    <_LightStudioPhotosStaticRid />
    <_LightStudioPhotosStaticRid Condition="'$(RuntimeIdentifier)' == 'osx-arm64' or '$(RuntimeIdentifier)' == 'osx-x64'">$(RuntimeIdentifier)</_LightStudioPhotosStaticRid>
    <_LightStudioPhotosStaticRid Condition="'$(RuntimeIdentifier)' == 'win-x64' or '$(RuntimeIdentifier)' == 'win-arm64'">$(RuntimeIdentifier)</_LightStudioPhotosStaticRid>
    <_LightStudioPhotosStaticRid Condition="'$(RuntimeIdentifier)' == 'linux-x64' or '$(RuntimeIdentifier)' == 'linux-arm64'">$(RuntimeIdentifier)</_LightStudioPhotosStaticRid>
    <_LightStudioPhotosStaticRid Condition="'$(RuntimeIdentifier)' == 'android-arm64' or '$(RuntimeIdentifier)' == 'android-x64'">$(RuntimeIdentifier)</_LightStudioPhotosStaticRid>
    <_LightStudioPhotosUseStatic>false</_LightStudioPhotosUseStatic>
    <_LightStudioPhotosUseStatic Condition="'$(EnableStaticPhotos)' == 'true' and '$(PublishAot)' == 'true' and '$(_LightStudioPhotosStaticRid)' != ''">true</_LightStudioPhotosUseStatic>
  </PropertyGroup>

  <ItemGroup Condition="'$(_LightStudioPhotosTargetsWasm)' == 'true'">
    <NativeFileReference Include="$(LightStudioPhotosPackageRoot)static/$(_LightStudioPhotosWasmFlavor)/libraw.a" />
    <NativeFileReference Include="$(LightStudioPhotosPackageRoot)static/$(_LightStudioPhotosWasmFlavor)/liblcms2.a" />
    <NativeFileReference Include="$(LightStudioPhotosPackageRoot)static/$(_LightStudioPhotosWasmFlavor)/libz.a" />
  </ItemGroup>

  <ItemGroup Condition="'$(_LightStudioPhotosUseStatic)' == 'true' and '$(_LightStudioPhotosStaticRid)' != 'win-x64' and '$(_LightStudioPhotosStaticRid)' != 'win-arm64'">
    <NativeLibrary Include="$(LightStudioPhotosPackageRoot)static/$(_LightStudioPhotosStaticRid)/libraw.a" />
    <NativeLibrary Include="$(LightStudioPhotosPackageRoot)static/$(_LightStudioPhotosStaticRid)/liblcms2.a" />
    <NativeLibrary Include="$(LightStudioPhotosPackageRoot)static/$(_LightStudioPhotosStaticRid)/libjpeg.a" />
    <NativeLibrary Include="$(LightStudioPhotosPackageRoot)static/$(_LightStudioPhotosStaticRid)/libz.a" />
  </ItemGroup>

  <ItemGroup Condition="'$(_LightStudioPhotosUseStatic)' == 'true' and ('$(_LightStudioPhotosStaticRid)' == 'osx-arm64' or '$(_LightStudioPhotosStaticRid)' == 'osx-x64')">
    <LinkerArg Include="-lc++" />
  </ItemGroup>

  <ItemGroup Condition="'$(_LightStudioPhotosUseStatic)' == 'true' and ('$(_LightStudioPhotosStaticRid)' == 'linux-x64' or '$(_LightStudioPhotosStaticRid)' == 'linux-arm64')">
    <NativeSystemLibrary Include="stdc++;m;pthread" />
  </ItemGroup>

  <ItemGroup Condition="'$(_LightStudioPhotosUseStatic)' == 'true' and ('$(_LightStudioPhotosStaticRid)' == 'android-arm64' or '$(_LightStudioPhotosStaticRid)' == 'android-x64')">
    <NativeSystemLibrary Include="c++_static;c++abi;dl;m" />
    <LinkerArg Include="-Wl,-z,max-page-size=16384" />
  </ItemGroup>

  <ItemGroup Condition="'$(_LightStudioPhotosUseStatic)' == 'true' and ('$(_LightStudioPhotosStaticRid)' == 'win-x64' or '$(_LightStudioPhotosStaticRid)' == 'win-arm64')">
    <NativeLibrary Include="$(LightStudioPhotosPackageRoot)static/$(_LightStudioPhotosStaticRid)/libraw.lib" />
    <NativeLibrary Include="$(LightStudioPhotosPackageRoot)static/$(_LightStudioPhotosStaticRid)/liblcms2.lib" />
    <NativeLibrary Include="$(LightStudioPhotosPackageRoot)static/$(_LightStudioPhotosStaticRid)/jpeg.lib" />
    <NativeLibrary Include="$(LightStudioPhotosPackageRoot)static/$(_LightStudioPhotosStaticRid)/zlib.lib" />
    <NativeLibrary Include="ws2_32.lib" />
  </ItemGroup>

  <Target Name="ValidateLightStudioPhotosWasm" BeforeTargets="PrepareForBuild"
          Condition="'$(_LightStudioPhotosTargetsWasm)' == 'true' and '$(WasmEnableExceptionHandling)' == 'false'">
    <Error Text="LightStudio.Photos requires WasmEnableExceptionHandling=true for LibRaw's C++ exceptions." />
  </Target>

  <Target Name="RemoveLightStudioPhotosRuntimeAssets" AfterTargets="ComputeResolvedFilesToPublishList"
          Condition="'$(_LightStudioPhotosUseStatic)' == 'true'">
    <ItemGroup>
      <_LightStudioPhotosPublishAssetToRemove Include="@(ResolvedFileToPublish)" Condition="'%(ResolvedFileToPublish.NuGetPackageId)' == 'LightStudio.Photos'" />
      <ResolvedFileToPublish Remove="@(_LightStudioPhotosPublishAssetToRemove)" />
    </ItemGroup>
  </Target>
</Project>