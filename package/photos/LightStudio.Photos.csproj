<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDefaultItems>false</EnableDefaultItems>
    <PackageId>LightStudio.Photos</PackageId>
    <Version>0.22.2</Version>
    <Authors>LightStudio</Authors>
    <Description>LibRaw 0.22.2 and Little CMS 2.19.1 native libraries for .NET, with libjpeg-turbo 3.1.3 and zlib 1.3.2 for compressed DNG support. Shared libraries for Android arm64/x64, Linux arm64/x64, macOS arm64/x64 and Windows arm64/x64 (MinGW), with static archives for single/multi-threaded browser-wasm and macOS/Windows native AOT (MSVC on Windows).</Description>
    <PackageTags>photos;raw;libraw;lcms2;color;native;android;linux;macos;windows;webassembly;wasm</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>(LGPL-2.1-or-later OR CDDL-1.0) AND MIT AND IJG AND Zlib AND (GPL-3.0-or-later WITH GCC-exception-3.1) AND (Apache-2.0 WITH LLVM-exception)</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/hjc4869/LightPlayer-Packages</RepositoryUrl>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <IsPackable>true</IsPackable>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <PhotosArtifactsPath Condition="'$(PhotosArtifactsPath)' == ''">$(MSBuildThisFileDirectory)../../artifacts</PhotosArtifactsPath>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(PhotosArtifactsPath)/photos-linux-x64/libraw.so;$(PhotosArtifactsPath)/photos-linux-x64/liblcms2.so" Pack="true" PackagePath="runtimes/linux-x64/native/" />
    <None Include="$(PhotosArtifactsPath)/photos-linux-arm64/libraw.so;$(PhotosArtifactsPath)/photos-linux-arm64/liblcms2.so" Pack="true" PackagePath="runtimes/linux-arm64/native/" />
    <None Include="$(PhotosArtifactsPath)/photos-win-x64/libraw.dll;$(PhotosArtifactsPath)/photos-win-x64/liblcms2.dll" Pack="true" PackagePath="runtimes/win-x64/native/" />
    <None Include="$(PhotosArtifactsPath)/photos-win-arm64/libraw.dll;$(PhotosArtifactsPath)/photos-win-arm64/liblcms2.dll" Pack="true" PackagePath="runtimes/win-arm64/native/" />
    <None Include="$(PhotosArtifactsPath)/photos-win-x64-static/*.lib" Pack="true" PackagePath="static/win-x64/" />
    <None Include="$(PhotosArtifactsPath)/photos-win-arm64-static/*.lib" Pack="true" PackagePath="static/win-arm64/" />
    <None Include="$(PhotosArtifactsPath)/photos-android/android-arm64/libraw.so;$(PhotosArtifactsPath)/photos-android/android-arm64/liblcms2.so" Pack="true" PackagePath="runtimes/android-arm64/native/" />
    <None Include="$(PhotosArtifactsPath)/photos-android/android-x64/libraw.so;$(PhotosArtifactsPath)/photos-android/android-x64/liblcms2.so" Pack="true" PackagePath="runtimes/android-x64/native/" />
    <None Include="$(PhotosArtifactsPath)/photos-osx-arm64/libraw.dylib;$(PhotosArtifactsPath)/photos-osx-arm64/liblcms2.dylib" Pack="true" PackagePath="runtimes/osx-arm64/native/" />
    <None Include="$(PhotosArtifactsPath)/photos-osx-x64/libraw.dylib;$(PhotosArtifactsPath)/photos-osx-x64/liblcms2.dylib" Pack="true" PackagePath="runtimes/osx-x64/native/" />
    <None Include="$(PhotosArtifactsPath)/photos-osx-arm64/libraw.a;$(PhotosArtifactsPath)/photos-osx-arm64/liblcms2.a;$(PhotosArtifactsPath)/photos-osx-arm64/libjpeg.a;$(PhotosArtifactsPath)/photos-osx-arm64/libz.a" Pack="true" PackagePath="static/osx-arm64/" />
    <None Include="$(PhotosArtifactsPath)/photos-osx-x64/libraw.a;$(PhotosArtifactsPath)/photos-osx-x64/liblcms2.a;$(PhotosArtifactsPath)/photos-osx-x64/libjpeg.a;$(PhotosArtifactsPath)/photos-osx-x64/libz.a" Pack="true" PackagePath="static/osx-x64/" />
    <None Include="$(PhotosArtifactsPath)/photos-browser-wasm-em3/libraw.a;$(PhotosArtifactsPath)/photos-browser-wasm-em3/liblcms2.a;$(PhotosArtifactsPath)/photos-browser-wasm-em3/libz.a" Pack="true" PackagePath="static/wasm-em3/" />
    <None Include="$(PhotosArtifactsPath)/photos-browser-wasm-mt-em3/libraw.a;$(PhotosArtifactsPath)/photos-browser-wasm-mt-em3/liblcms2.a;$(PhotosArtifactsPath)/photos-browser-wasm-mt-em3/libz.a" Pack="true" PackagePath="static/wasm-mt-em3/" />
    <None Include="$(PhotosArtifactsPath)/photos-browser-wasm-em6/libraw.a;$(PhotosArtifactsPath)/photos-browser-wasm-em6/liblcms2.a;$(PhotosArtifactsPath)/photos-browser-wasm-em6/libz.a" Pack="true" PackagePath="static/wasm-em6/" />
    <None Include="$(PhotosArtifactsPath)/photos-browser-wasm-mt-em6/libraw.a;$(PhotosArtifactsPath)/photos-browser-wasm-mt-em6/liblcms2.a;$(PhotosArtifactsPath)/photos-browser-wasm-mt-em6/libz.a" Pack="true" PackagePath="static/wasm-mt-em6/" />
    <None Include="build/LightStudio.Photos.props" Pack="true" PackagePath="build/;buildTransitive/" />
    <None Include="build/LightStudio.Photos.targets" Pack="true" PackagePath="build/;buildTransitive/" />
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="../../libraw/COPYRIGHT;../../libraw/LICENSE.LGPL;../../libraw/LICENSE.CDDL" Pack="true" PackagePath="licenses/LibRaw/" />
    <None Include="../../lcms2/LICENSE" Pack="true" PackagePath="licenses/Little-CMS/" />
    <None Include="../../libjpeg-turbo/LICENSE.md;../../libjpeg-turbo/README.ijg" Pack="true" PackagePath="licenses/libjpeg-turbo/" />
    <None Include="../../zlib/LICENSE" Pack="true" PackagePath="licenses/zlib/" />
    <None Include="$(PhotosArtifactsPath)/photos-android/android-arm64/licenses/NOTICE.toolchain" Pack="true" PackagePath="licenses/Android/" />
    <None Include="$(PhotosArtifactsPath)/photos-win-x64/licenses/GCC-copyright.txt;$(PhotosArtifactsPath)/photos-win-x64/licenses/MinGW-copyright.txt;$(PhotosArtifactsPath)/photos-win-x64/licenses/GPL-3.txt" Pack="true" PackagePath="licenses/MinGW/" />
    <None Include="$(PhotosArtifactsPath)/photos-win-arm64/licenses/LLVM-MinGW-LICENSE.txt;$(PhotosArtifactsPath)/photos-win-arm64/licenses/COPYING.MinGW-w64.txt;$(PhotosArtifactsPath)/photos-win-arm64/licenses/COPYING.MinGW-w64-runtime.txt" Pack="true" PackagePath="licenses/LLVM-MinGW/" />
  </ItemGroup>
</Project>