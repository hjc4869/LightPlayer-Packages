<Project>
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Version>8.1.2</Version>
    <Authors>LightStudio</Authors>
    <PackageLicenseExpression>LGPL-2.1-or-later</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/hjc4869/LightPlayer-Packages</RepositoryUrl>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(FFmpegArtifactsPath)/*.a" Pack="true" PackagePath="runtimes/osx-arm64/native/" />
    <None Include="$(FFmpegArtifactsPath)/*.dylib" Pack="true" PackagePath="runtimes/osx-arm64/native/" />
    <None Include="$(PackageReadmeFile)" Pack="true" PackagePath="/" />
    <None Include="../ffmpeg/LICENSE.md" Pack="true" PackagePath="licenses/FFmpeg-LICENSE.md" />
    <None Include="../ffmpeg/COPYING.LGPLv2.1" Pack="true" PackagePath="licenses/" />
  </ItemGroup>

  <Target Name="ValidateFFmpegLibraries" BeforeTargets="GenerateNuspec">
    <ItemGroup>
      <_FFmpegArchive Include="$(FFmpegArtifactsPath)/*.a" />
      <_FFmpegDynamicLibrary Include="$(FFmpegArtifactsPath)/*.dylib" />
    </ItemGroup>
    <Error Condition="'@(_FFmpegArchive)' == ''" Text="No FFmpeg archives were found in '$(FFmpegArtifactsPath)'. Build FFmpeg before packing." />
    <Error Condition="'@(_FFmpegDynamicLibrary)' == ''" Text="No FFmpeg dynamic libraries were found in '$(FFmpegArtifactsPath)'. Build FFmpeg before packing." />
  </Target>
</Project>
