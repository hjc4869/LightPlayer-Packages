<Project>
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Version>8.1.2</Version>
    <Authors>LightStudio</Authors>
    <PackageLicenseExpression>LGPL-2.1-or-later AND BSD-2-Clause</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/hjc4869/LightPlayer-Packages</RepositoryUrl>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(FFmpegArtifactsPath)/*.a" Pack="true" PackagePath="runtimes/browser-wasm/native/" />
    <None Include="$(PackageReadmeFile)" Pack="true" PackagePath="/" />
    <None Include="../ffmpeg/LICENSE.md" Pack="true" PackagePath="licenses/FFmpeg-LICENSE.md" />
    <None Include="../ffmpeg/COPYING.LGPLv2.1" Pack="true" PackagePath="licenses/" />
    <None Include="../dav1d/COPYING" Pack="true" PackagePath="licenses/dav1d/" />
  </ItemGroup>

  <Target Name="ValidateFFmpegArchives" BeforeTargets="GenerateNuspec">
    <ItemGroup>
      <_FFmpegArchive Include="$(FFmpegArtifactsPath)/*.a" />
      <_Dav1dArchive Include="$(FFmpegArtifactsPath)/libdav1d.a" />
    </ItemGroup>
    <Error Condition="'@(_FFmpegArchive)' == ''" Text="No FFmpeg archives were found in '$(FFmpegArtifactsPath)'. Build FFmpeg before packing." />
    <Error Condition="'@(_Dav1dArchive)' == ''" Text="No dav1d archive was found in '$(FFmpegArtifactsPath)'. Build FFmpeg before packing." />
  </Target>
</Project>