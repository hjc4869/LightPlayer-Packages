<Project>
  <Target Name="ValidateLightStudioOnnxPlatform" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(RuntimeIdentifier)' == 'browser-wasm' or '$(TargetPlatformIdentifier)' == 'browser'" Text="LightStudio.Onnx does not ship browser-wasm: upstream browser WebGPU requires an asynchronous JavaScript bridge that is not supported by the full synchronous .NET API in a threaded WASM application." />
    <ItemGroup>
      <_LightStudioOnnxConflict Include="@(PackageReference)" Condition="$([System.String]::Copy('%(PackageReference.Identity)').StartsWith('Microsoft.ML.OnnxRuntime'))" />
    </ItemGroup>
    <Error Condition="'@(_LightStudioOnnxConflict)' != ''" Text="LightStudio.Onnx already bundles the managed ONNX Runtime API and native libraries. Remove conflicting Microsoft ONNX Runtime references: @(_LightStudioOnnxConflict)." />
  </Target>
</Project>